# SQLite database file (relative to the prisma/ directory)
DATABASE_URL="file:./dev.db"

# Demo mode enables one-click role switching and the reviewer-only demo clock.
# Never enable in a real deployment.
DEMO_MODE="true"

# Optional. When absent, extraction uses the labeled deterministic fixture extractor.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
