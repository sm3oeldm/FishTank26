# SQLite database file (relative to the prisma/ directory)
DATABASE_URL="file:./dev.db"

# Demo mode enables one-click role switching and the reviewer-only demo clock.
# Never enable in a real deployment.
DEMO_MODE="true"

# Optional LLM for extraction (Gemini preferred if both set). When absent, the labeled
# deterministic fixture extractor is used. Keys are read server-side only.
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3-flash-preview"
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
